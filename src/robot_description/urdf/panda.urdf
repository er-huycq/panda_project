<?xml version="1.0" ?>
<robot name="panda" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <link name="world"/>
    <joint name="connect_root_and_world" type="fixed">
      <child link="panda_link0" />
      <parent link="world" />
      <origin xyz="0 0 0" rpy="0 0 0" />    
    </joint> 

    <link name="panda_link0">
        <visual>
            <geometry>
                <mesh filename="package://robot_description/meshes/visual/link0.dae" />
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://robot_description/meshes/collision/link0.stl" />
            </geometry>
        </collision>
	    <inertial>
		  <origin xyz="0 0 0.32"/>
		  <mass value="50"/> 
		  <inertia ixx="0.2" ixy="0" ixz="0" iyy="0.2" iyz="0" izz="0.4" />
	    </inertial>
    </link>
    <link name="panda_link1">
        <visual>
            <geometry>
                <mesh filename="package://robot_description/meshes/visual/link1.dae" />
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://robot_description/meshes/collision/link1.stl" />
            </geometry>
        </collision>
	    <inertial>
		  <origin xyz="0 0 0.32"/>
		  <mass value="0.5"/> 
		  <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002" />
	    </inertial>
    </link>
    <joint name="panda_joint1" type="revolute">
        <origin rpy="0 0 0" xyz="0 0 0.333" />
        <parent link="panda_link0" />
        <child link="panda_link1" />
        <axis xyz="0 0 1" />
        <limit effort="87" lower="-2.99" upper="2.99" velocity="2.3925" />
    </joint>
    <link name="panda_link2">
        <visual>
            <geometry>
                <mesh filename="package://robot_description/meshes/visual/link2.dae" />
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://robot_description/meshes/collision/link2.stl" />
            </geometry>
        </collision>
	    <inertial>
		  <origin xyz="0 0 0.32"/>
		  <mass value="0.5"/> 
		  <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002" />
	    </inertial>
    </link>
    <joint name="panda_joint2" type="revolute">
        <origin rpy="-1.57079632679 0 0" xyz="0 0 0" />
        <parent link="panda_link1" />
        <child link="panda_link2" />
        <axis xyz="0 0 1" />
        <limit effort="87" lower="-2.0" upper="2.0" velocity="2.3925" />
    </joint>
    <link name="panda_link3">
        <visual>
            <geometry>
                <mesh filename="package://robot_description/meshes/visual/link3.dae" />
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://robot_description/meshes/collision/link3.stl" />
